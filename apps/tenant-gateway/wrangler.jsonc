{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-core-tenant-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "services": [
    {
      "binding": "TENANT_API",
      "service": "nova-core-tenant-api"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0,
    "redactQueryString": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
