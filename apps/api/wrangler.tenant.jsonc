{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-core-tenant-api",
  "main": "tenant_worker.py",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "python_modules": {
    "exclude": ["**/*.pyc", "**/*.dist-info/top_level.txt", "**/*.dist-info/entry_points.txt"]
  },
  "observability": {
    "enabled": true,
    "redactQueryString": true
  }
}
